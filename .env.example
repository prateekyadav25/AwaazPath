# =================================================================
# AwaazPath Environment Configuration
# Gnani AI Internship Challenge
# =================================================================

# Gnani AI API Key (Obtain from https://app.gnani.ai)
# Note: Keep this on the server. Never expose in client-side code.
GNANI_API_KEY=your_gnani_api_key_here

# Gnani Speech-to-Text Model (Default: prisma-v3.0)
GNANI_STT_MODEL=prisma-v3.0

# Gnani Text-to-Speech Model (Default: timbre-v3.0 or timbre-v2.5)
GNANI_TTS_MODEL=timbre-v3.0

# Optional External Reasoning LLM API Key (if you wish to enable extended LLM analysis)
# The application includes a deterministic rubric-based evaluation engine that works 100% offline without any paid LLM API.
OPENAI_API_KEY=

